# ==============================================================================
# X-Finder AI Agent - Modèle de variables d'environnement (.env.example)
# Copiez ce fichier en .env et renseignez vos clés réelles
# ==============================================================================

# 1. Fournisseur LLM (RodiumAI / OpenAI compatible)
RODIUMAI_API_KEY=rd_sk_votre_cle_ici
BASE_URL=https://api.rodiumai.io/v1
ALLOWED_MODELS=google/gemini-3.8-flash,anthropic/claude-sonnet-4-5-20250929,google/gemini-3.5-flash
DEFAULT_MODEL=google/gemini-3.8-flash

# 2. Outils de Recherche Internet (Tavily Search API)
# Offre gratuite disponible sur https://tavily.com
TAVILY_API_KEY=tvly-votre_cle_tavily_ici

# 3. Météo (Optionnel si vide : repli automatique vers Open-Meteo gratuit sans clé)
WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# 4. Google Workspace (Calendar & Drive API)
# Fichier OAuth 2.0 téléchargé depuis Google Cloud Console
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# 5. Notion API (Integration Token)
# Obtenu sur https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DEFAULT_PARENT_PAGE_ID=

# 6. Envoi d'Emails (SMTP)
# La clé SMTP Brevo est un secret : ne la partagez pas et ne la commitez jamais.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=bfe9be001@smtp-brevo.com
SMTP_PASSWORD=
# Adresse d'expédition validée dans votre compte Brevo (différente de SMTP_USER).
SMTP_FROM_EMAIL=flowoliv@gmail.com
SMTP_USE_TLS=true
# Préférer l'API HTTPS Brevo à SMTP sur les hébergeurs qui bloquent les ports SMTP sortants.
BREVO_API_KEY=

# 7. Données & RAG
DATABASE_URL=sqlite:///./chat.db
RAG_DATA_DIR=./data/knowledge
UPLOAD_DIR=./data/uploads

# 8. Serveur & Sécurité
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=
SESSION_TTL_HOURS=720
SECRET_KEY=changez-par-une-cle-aleatoire-de-32-caracteres-minimum

# 9. Connexion sociale OAuth (facultatif en local)
# Les URL de callback doivent correspondre exactement à celles déclarées chez le fournisseur.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
